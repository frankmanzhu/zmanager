namespace zmanager {
    HealthcheckResult healthcheck();
    ListFormatsResult listFormats();
    [Throws=ZmanagerGuiError]
    DetectArchiveResult detectArchive(DetectArchiveRequest request);
    [Throws=ZmanagerGuiError]
    ListArchiveResult listArchive(ListArchiveRequest request);
    [Throws=ZmanagerGuiError]
    ArchiveSessionOpenResult openArchiveSession(ArchiveSessionOpenRequest request);
    [Throws=ZmanagerGuiError]
    ArchiveSessionListResult listArchiveSession(ArchiveSessionListRequest request);
    [Throws=ZmanagerGuiError]
    ArchiveSessionExtractResult extractArchiveSessionEntry(ArchiveSessionExtractRequest request);
    [Throws=ZmanagerGuiError]
    ArchiveSessionCloseResult closeArchiveSession(ArchiveSessionCloseRequest request);
    [Throws=ZmanagerGuiError]
    TestArchiveResult testArchive(TestArchiveRequest request);
    [Throws=ZmanagerGuiError]
    MaterializePreviewResult materializePreview(MaterializePreviewRequest request);
    [Throws=ZmanagerGuiError]
    PlanExtractResult planExtract(PlanExtractRequest request);
    [Throws=ZmanagerGuiError]
    PlanCreateResult planCreate(PlanCreateRequest request);
    [Throws=ZmanagerGuiError]
    StartJobResult startCreate(StartCreateRequest request);
    [Throws=ZmanagerGuiError]
    StartJobResult startExtract(StartExtractRequest request);
    [Throws=ZmanagerGuiError]
    PollJobEventsResult pollJobEvents(PollJobEventsRequest request);
    [Throws=ZmanagerGuiError]
    CancelJobResult cancelJob(CancelJobRequest request);
    ClearSensitiveStateResult clearSensitiveState();

    // TZAP service endpoints. Each returns a JSON response envelope
    // documented by the zmanager-core `tzap_service` module.
    string tzapPublicMetadataSummary(string archive_path);
    string tzapPublicMetadataDisplaySummary(string archive_path);
    string verifyTzapX509(string archive_path, string? password, sequence<string> trusted_ca_certs, boolean trusted_system_roots);
    string verifyTzapX509PublicNoKey(string archive_path, sequence<string> trusted_ca_certs, boolean trusted_system_roots);
    string inspectTzapX509Signer(string archive_path, string? password);
    string inspectTzapX509PublicNoKeySigner(string archive_path);
    string createTzapSelfSignedIdentity(string identity_path, string public_certificate_path, string common_name, string password);
    // These seven (login/callback/status/certificate_inventory/cert_enroll/
    // document_sign/document_verify) are typed (Track 12a of
    // zmanager-mobile's docs/mobile-code-health-remediation-plan.md) — the
    // only ones zmanager-mobile calls. zmanager-tzap-hosted's own
    // tzap_*_json functions underneath are unchanged; the JSON boundary
    // just moved from native callers into this crate. The rest stay JSON
    // passthrough: no mobile caller exists yet to type them against.
    [Throws=ZmanagerGuiError]
    TzapAuthLoginResult tzapAuthLogin(TzapAuthLoginRequest request);
    [Throws=ZmanagerGuiError]
    void tzapAuthCallback(TzapAuthCallbackRequest request);
    [Throws=ZmanagerGuiError]
    TzapAuthStatusResult tzapAuthStatus(TzapAuthStatusRequest request);
    string tzap_auth_forget_json(string request_json);
    string tzap_auth_account_url_json(string request_json);
    [Throws=ZmanagerGuiError]
    TzapCertificateInventoryResult tzapCertificateInventory(TzapCertificateInventoryRequest request);
    [Throws=ZmanagerGuiError]
    void tzapCertEnroll(TzapCertEnrollRequest request);
    string tzap_cert_renew_json(string request_json);
    string tzap_cert_revoke_json(string request_json);
    string tzap_device_retire_json(string request_json);
    [Throws=ZmanagerGuiError]
    TzapDocumentSignResult tzapDocumentSign(TzapDocumentSignRequest request);
    [Throws=ZmanagerGuiError]
    TzapDocumentVerifyResult tzapDocumentVerify(TzapDocumentVerifyRequest request);
    string tzap_recipient_key_generate_json(string request_json);
    string tzap_recipient_key_remove_json(string request_json);
    string tzap_contact_export_json(string request_json);
    string tzap_contact_import_json(string request_json);
    string tzap_contact_list_json(string request_json);
    string tzap_contact_remove_json(string request_json);
    string tzap_share_create_json(string request_json);

    // LocalSend endpoints. Typed at the FFI boundary (Track 12a of
    // zmanager-mobile's docs/mobile-code-health-remediation-plan.md) so both
    // native shells consume UniFFI-generated request/response types instead
    // of hand-mirrored JSON DTOs; the underlying protocol is unmodified
    // upstream `localsend-rs` — push-only, same as official LocalSend apps.
    [Throws=ZmanagerGuiError]
    sequence<DeviceInfoDto> localsendDiscover(DiscoverRequest request);
    [Throws=ZmanagerGuiError]
    void localsendStartReceiver(StartReceiverRequest request);
    [Throws=ZmanagerGuiError]
    void localsendStopReceiver();
    PollEventsResult localsendPollEvents();
    [Throws=ZmanagerGuiError]
    void localsendRespondToTransfer(RespondToTransferRequest request);
    [Throws=ZmanagerGuiError]
    SendFileResult localsendSendFile(SendFileRequest request);
    [Throws=ZmanagerGuiError]
    void localsendCancelSend(CancelSendRequest request);
};

enum BridgeSeverity {
    "Info",
    "Warning",
    "Error"
};

dictionary BridgeError {
    string code;
    string message;
    string? recovery_hint;
    BridgeSeverity severity;
    boolean retryable;
};

dictionary HealthcheckResult {
    string status;
    string engine;
    string version;
    boolean ready;
    string summary;
};

dictionary FormatDescriptor {
    string kind;
    string label;
    sequence<string> extensions;
    boolean can_list;
    boolean can_extract;
    boolean can_create;
    boolean recognized;
    boolean platform_available;
    string? unavailable_reason;
    string? source_access;
    boolean encryption_supported;
};

dictionary ListFormatsResult {
    sequence<FormatDescriptor> formats;
};

enum ArchiveFormat {
    "Zip",
    "SplitZip",
    "Rar",
    "MultipartRar",
    "SevenZ",
    "Tar",
    "TarGz",
    "TarBz2",
    "TarXz",
    "TarZst",
    "TarLzma",
    "TarLz",
    "TarLzo",
    "TarCompress",
    "TarLz4",
    "TarUu",
    "Iso",
    "Cab",
    "Cpio",
    "Rpm",
    "Xar",
    "Pkg",
    "Dmg",
    "Lha",
    "Ar",
    "Warc",
    "Mtree",
    "Deb",
    "Msi",
    "Vhd",
    "Vmdk",
    "Udf",
    "Gzip",
    "Bzip2",
    "Xz",
    "Zstd",
    "Tzap",
    "AppleArchive",
    "Xip",
    "RawStream",
    "Other"
};

dictionary DetectArchiveRequest {
    string archive_path;
};

dictionary DetectArchiveResult {
    string archive_path;
    ArchiveFormat format;
    string format_label;
    boolean exists;
    boolean is_file;
    boolean can_list;
    boolean can_extract;
    boolean can_create;
    sequence<BridgeError> warnings;
};

enum ArchiveEntryKind {
    "File",
    "Directory",
    "Symlink",
    "Hardlink",
    "Special"
};

dictionary ArchiveEntry {
    string path;
    ArchiveEntryKind kind;
    boolean is_dir;
    u64? size;
    u64? compressed_size;
    string? modified_at;
    string? link_target;
};

dictionary ListArchiveRequest {
    string archive_path;
    string? password;
};

dictionary ListArchiveResult {
    string archive_path;
    ArchiveFormat format;
    string format_label;
    sequence<ArchiveEntry> entries;
    u64 entry_count;
    u64? total_size;
    sequence<BridgeError> warnings;
};

dictionary ArchiveSessionOpenRequest {
    string archive_path;
    string? password;
};

dictionary ArchiveSessionOpenResult {
    string session_id;
};

dictionary ArchiveSessionListRequest {
    string session_id;
};

dictionary ArchiveSessionEntry {
    u64 entry_id;
    string path;
    ArchiveEntryKind kind;
    u64? size;
};

dictionary ArchiveSessionListResult {
    string session_id;
    sequence<ArchiveSessionEntry> entries;
};

dictionary ArchiveSessionExtractRequest {
    string session_id;
    u64 entry_id;
    string destination_root;
    ExtractionCollisionPolicy collision_policy;
};

dictionary ArchiveSessionExtractResult {
    string session_id;
    u64 entry_id;
    u64 written_bytes;
    sequence<BridgeError> warnings;
};

dictionary ArchiveSessionCloseRequest {
    string session_id;
};

dictionary ArchiveSessionCloseResult {
    string session_id;
};

dictionary TestArchiveRequest {
    string archive_path;
    string? password;
    sequence<string> selected_paths;
};

dictionary TestArchiveResult {
    string archive_path;
    ArchiveFormat format;
    string format_label;
    boolean verified;
    u64 tested_entries;
    u64 skipped_entries;
    u64 total_entries;
    u64 tested_bytes;
    sequence<BridgeError> warnings;
};

dictionary MaterializePreviewRequest {
    string archive_path;
    string entry_path;
    string? password;
    u64 strip_components;
};

dictionary MaterializePreviewResult {
    string archive_path;
    string entry_path;
    string cleanup_root;
    string preview_path;
    u64 written_bytes;
    sequence<BridgeError> warnings;
};

enum ExtractionCollisionPolicy {
    "Refuse",
    "Replace",
    "Rename"
};

enum ExtractionPlanEntryStatus {
    "Write",
    "Skip",
    "Block"
};

dictionary PlanExtractRequest {
    string archive_path;
    string destination_root;
    string? password;
    sequence<string> selected_paths;
    u64 strip_components;
    ExtractionCollisionPolicy collision_policy;
};

dictionary ExtractionPlanEntry {
    string archive_path;
    string? normalized_path;
    string? destination_path;
    ArchiveEntryKind kind;
    ExtractionPlanEntryStatus status;
    string? reason;
    u64? size;
    u64? compressed_size;
    boolean replace_existing;
};

dictionary PlanExtractResult {
    string archive_path;
    string destination_root;
    ArchiveFormat format;
    string format_label;
    sequence<ExtractionPlanEntry> entries;
    u64 total_entries;
    u64 writable_entries;
    u64 skipped_entries;
    u64 blocked_entries;
    u64? estimated_bytes;
    boolean can_start;
    sequence<BridgeError> warnings;
    string plan_token;
};

enum CreateArchiveFormat {
    "Zip",
    "SevenZ",
    "TarZst",
    "TarGz",
    "Tzap",
    "AppleArchive"
};

dictionary PlanCreateRequest {
    sequence<string> source_paths;
    string destination_archive_path;
    CreateArchiveFormat format;
    string? password;
    boolean preserve_metadata;
    boolean replace_existing;
    boolean clean_source;
    boolean verify_after_create;
};

dictionary CreatePlanEntry {
    string archive_path;
    string source_path;
    ArchiveEntryKind kind;
    u64 size;
};

dictionary PlanCreateResult {
    sequence<string> source_paths;
    string destination_archive_path;
    CreateArchiveFormat format;
    string format_label;
    sequence<CreatePlanEntry> entries;
    u64 total_entries;
    u64 total_bytes;
    u64 excluded_entries;
    u64 excluded_bytes;
    boolean output_exists;
    boolean replace_existing;
    boolean encrypted;
    boolean preserve_metadata;
    boolean clean_source;
    boolean verify_after_create;
    boolean verify_supported;
    boolean can_start;
    sequence<BridgeError> warnings;
};

dictionary StartCreateRequest {
    sequence<string> source_paths;
    string destination_archive_path;
    CreateArchiveFormat format;
    string? password;
    boolean preserve_metadata;
    boolean replace_existing;
    boolean clean_source;
    boolean verify_after_create;
    sequence<string> excluded_paths;
    u32 level;
    boolean encrypt_file_names;
    u64? volume_size;
    u8 recovery_percentage;
    u8 volume_loss_tolerance;
    string? tzap_signing_certificate;
    string? tzap_signing_private_key;
    sequence<string> tzap_signing_chain;
    string? tzap_identity;
    string? tzap_identity_password;
};

enum MobileJobStatus {
    "Queued",
    "Running",
    "Completed",
    "Failed",
    "Cancelled"
};

enum MobileJobKind {
    "ZipCreate",
    "ZipExtract",
    "SevenZCreate",
    "SevenZExtract",
    "RarExtract",
    "TarZstdCreate",
    "TarZstdExtract",
    "TzapCreate",
    "TzapExtract",
    "AppleArchiveCreate",
    "AppleArchiveExtract",
    "ArchiveExtract",
    "RawStreamExtract",
    "TestArchive",
    "TarGzCreate"
};

enum MobileJobEventKind {
    "Started",
    "EntryStarted",
    "BytesProcessed",
    "EntryFinished",
    "Warning",
    "Completed",
    "Failed",
    "Cancelled"
};

dictionary MobileJobEvent {
    u64 sequence;
    MobileJobEventKind event_type;
    MobileJobKind? job_kind;
    string? path;
    u64? bytes;
    u64? total_bytes;
    u64? total_bytes_processed;
    u64? entries;
    u64? total_entries;
    string? message;
    BridgeError? error;
};

dictionary JobTerminalSummary {
    u64 written_entries;
    u64? skipped_entries;
    u64 written_bytes;
    boolean? encrypted;
    u64? volume_size;
    u64? volume_count;
    sequence<string> output_paths;
    boolean? verified;
    u64? verified_entries;
    u64? verified_bytes;
    sequence<BridgeError> warnings;
};

dictionary StartExtractRequest {
    string archive_path;
    string destination_root;
    string? password;
    sequence<string> selected_paths;
    u64 strip_components;
    ExtractionCollisionPolicy collision_policy;
    string plan_token;
};

dictionary StartJobResult {
    string job_id;
    MobileJobKind kind;
    MobileJobStatus status;
};

dictionary PollJobEventsRequest {
    string job_id;
    u64 cursor;
};

dictionary PollJobEventsResult {
    string job_id;
    MobileJobKind kind;
    MobileJobStatus status;
    sequence<MobileJobEvent> events;
    u64 next_cursor;
    u64 min_retained_sequence;
    boolean is_terminal;
    JobTerminalSummary? terminal_summary;
};

dictionary CancelJobRequest {
    string job_id;
};

dictionary CancelJobResult {
    string job_id;
    MobileJobStatus status;
    boolean cancel_requested;
};

dictionary ClearSensitiveStateResult {
    u64 cleared_terminal_jobs;
    u64 cancel_requested_jobs;
    u64 retained_active_jobs;
};

// ---------------------------------------------------------------------
// LocalSend (Track 12a) — mirrors zmanager-localsend::registry's request
// and response shapes one-to-one; PathBuf fields cross the FFI boundary as
// string, matching every other path field in this file.
// ---------------------------------------------------------------------

dictionary StartReceiverRequest {
    string alias;
    u16 port;
    boolean https;
    string save_dir;
    boolean auto_accept;
    string? pin;
};

dictionary DiscoverRequest {
    string alias;
    u16 port;
    boolean https;
    u64 timeout_ms;
};

dictionary DeviceInfoDto {
    string alias;
    string fingerprint;
    u16 port;
    string protocol;
    string? ip;
    string? device_model;
};

dictionary TransferFile {
    string id;
    string file_name;
    u64 size;
    string file_type;
};

[Enum]
interface QueuedEvent {
    PeerRegistered(DeviceInfoDto device);
    TransferRequest(string request_id, DeviceInfoDto sender, sequence<TransferFile> files);
    TextReceived(string session_id, string text, string sender_alias);
    FileReceiveProgress(
        string session_id,
        string file_id,
        string file_name,
        string sender_alias,
        u64 bytes_received,
        u64 total_bytes,
        u64 file_count
    );
    FileReceived(string session_id, string file_id, string file_name, string path);
    SessionDone(string session_id);
    FileSendProgress(
        string send_id,
        string session_id,
        string file_id,
        string file_name,
        u64 bytes_sent,
        u64 total_bytes,
        double rate_bytes_per_second
    );
};

dictionary PollEventsResult {
    sequence<QueuedEvent> events;
};

enum TransferDecisionKind {
    "Accept",
    "AcceptFiles",
    "Decline",
    "Refuse"
};

dictionary RespondToTransferRequest {
    string request_id;
    TransferDecisionKind decision;
    sequence<string> file_ids;
    string? reason;
};

dictionary SendFileRequest {
    string send_id;
    string alias;
    u16 self_port;
    boolean https;
    DeviceInfoDto target;
    string file_path;
    string? pin;
};

dictionary SendFileResult {
    string session_id;
    string file_id;
};

dictionary CancelSendRequest {
    string send_id;
};

// ---------------------------------------------------------------------
// TZAP hosted identity (Track 12a) — request/response shapes for the seven
// mobile-used functions. zmanager-tzap-hosted's own JSON contract stays
// dynamic underneath (it reads a serde_json::Value with defaulted optional
// fields, not a fixed struct); these dictionaries carry only the fields
// zmanager-mobile actually sends or reads today, trimmed per function
// rather than the one-size-fits-all request blob every native caller used
// to build by hand. `envelope_json` stays an opaque JSON string end to end
// (signed, stored, and replayed byte-for-byte) rather than a modeled
// dictionary — mobile never inspects its fields.
// ---------------------------------------------------------------------

dictionary TzapAuthLoginRequest {
    string state_dir;
    string account_key;
    string client_id;
    string redirect_uri;
    string auth_base_url;
    string account_base_url;
};

dictionary TzapAuthLoginResult {
    string launch_url;
};

dictionary TzapAuthCallbackRequest {
    string state_dir;
    string account_key;
    string client_id;
    string redirect_uri;
    string auth_base_url;
    string callback_url;
    string state;
    string handoff_code;
};

dictionary TzapAuthStatusRequest {
    string state_dir;
    string account_key;
};

dictionary TzapAuthStatusResult {
    boolean authenticated;
};

dictionary TzapCertEnrollRequest {
    string state_dir;
    string account_key;
    string service_base_url;
    sequence<string> custom_trust_root_cert_paths;
    u64 requested_validity_seconds;
};

dictionary TzapCertificateInventoryRequest {
    string state_dir;
    string account_key;
};

dictionary TzapCertificateInventoryResult {
    sequence<string> certificate_ids;
};

dictionary TzapDocumentPayload {
    u32 tzap_payload_version;
    string title;
    string body;
};

dictionary TzapDocumentSignRequest {
    string state_dir;
    string account_key;
    string certificate_id;
    TzapDocumentPayload payload;
};

dictionary TzapDocumentSignResult {
    string envelope_json;
};

dictionary TzapDocumentVerifyRequest {
    string envelope_json;
    sequence<string> custom_trust_root_cert_paths;
    u64 verifier_time_unix_seconds;
};

dictionary TzapDocumentVerifyResult {
    string state;
};

[Error]
interface ZmanagerGuiError {
    Bridge(string code, string user_message, string? recovery_hint, BridgeSeverity severity, boolean retryable);
};
